# ─────────────────────────────────────────────────────────────
# VELA-X Ops Console — משתני סביבה
# העתק לקובץ .env ומלא ערכים אמיתיים. אין להעלות .env ל־git.
# ─────────────────────────────────────────────────────────────

# מסד נתונים (חובה). PostgreSQL 14+.
DATABASE_URL="postgresql://localhost:5432/velax_ops"

# סביבה: development | staging | production
APP_ENV="development"

# מפתח לחתימת עוגיות ההתחברות. חובה בפרודקשן. ייצור: openssl rand -base64 48
AUTH_SECRET="change-me-in-production-min-32-chars-long-secret"

# מפתח להצפנת סודות מכשירים (Device Auth Keys) ב־DB. חובה. 32 בתים ב־base64.
# ייצור: openssl rand -base64 32
DEVICE_KEY_ENCRYPTION_KEY="change-me-32-byte-base64-key-here-aaaaaaaaaa="

# משך תוקף Session של משתמש מערכת, בשעות
SESSION_TTL_HOURS="12"

# ─── אינטגרציות חיצוניות ───
# כל אחת מהן פועלת כרגע במצב mock. הזנת credentials אמיתיים תחליף את ה־Adapter.
# ראה INTEGRATIONS.md

# ספק סליקה — mock | tranzila | cardcom | stripe
PAYMENT_PROVIDER="mock"
PAYMENT_API_KEY=""
PAYMENT_TERMINAL_ID=""

# שכבת בקרת מכשיר (BLE Gateway) — mock | http
DEVICE_PROVIDER="mock"
DEVICE_GATEWAY_URL=""
DEVICE_GATEWAY_TOKEN=""

# מערכת הזמנת מגרשים של המועדון — mock | http
BOOKING_PROVIDER="mock"
BOOKING_API_URL=""
BOOKING_API_KEY=""

# ערוצי התראות — כולם mock עד להזנת credentials
NOTIFY_EMAIL_PROVIDER="mock"
NOTIFY_SMS_PROVIDER="mock"
NOTIFY_WHATSAPP_PROVIDER="mock"
NOTIFY_SLACK_WEBHOOK_URL=""

# אחסון קבצים — local | s3 | supabase
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./storage"
